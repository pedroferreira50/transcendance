# Copy this file to .env (ignored by Git) and fill the values.
# Used by docker-compose.prod.yml. For local development, backend/.env is used instead.
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origin of the browser. With nginx over HTTPS this is https://localhost
FRONTEND_ORIGIN=https://localhost

# true when served over HTTPS (the session cookie only travels on HTTPS)
COOKIE_SECURE=true

# SQLite file used by the backend (the folder is a Docker volume in production)
DATABASE_URL=file:/app/data/users.db