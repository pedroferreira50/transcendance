{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "npm run db:generate && tsc",
    "start": "prisma migrate deploy && node dist/server.js",
    "test": "vitest",
    "debug": "tsx src/game/debug.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true
  }
}
